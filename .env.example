# Content database (Turso remote, or local SQLite outside the release zip)
# Local default used by the Go API when unset:
#   file:/var/meet-and-talk/content/local.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# How long (seconds) to cache Turso content in Next.js. Default: 60
CONTENT_REVALIDATE_SECONDS=60

# Optional: POST /api/revalidate-content with Authorization: Bearer <secret>
CONTENT_REVALIDATE_SECRET=

# --- Go admin API (api/) ---
ADMIN_API_TOKEN=change-me-to-a-long-random-secret
HTTP_ADDR=:3080
UPLOAD_DIR=/var/meet-and-talk/uploads
UPLOAD_URL_PREFIX=/uploads
# Called by the Go API after successful writes (optional)
CONTENT_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate-content
